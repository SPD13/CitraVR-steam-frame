<?xml version="1.0" encoding="utf-8"?>
<!-- The controller diagram shown in VR (VrControllerDiagramLayer). Sizes are in
     pixels of the panel (the panels' virtual displays are at 160 dpi). The labels
     are added by VrControllerDiagramLayer, from the current mapping. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/black"
    android:paddingStart="40dp"
    android:paddingEnd="40dp">

    <ImageView
        android:layout_width="1600dp"
        android:layout_height="816dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/vr_controller_diagram" />

    <FrameLayout
        android:id="@+id/controller_diagram_labels"
        android:layout_width="1600dp"
        android:layout_height="816dp" />
</FrameLayout>
